{
  "manifest_version": 3,
  "name": "Flow",
  "version": "1.1.0",
  "description": "Local agent bridge for Google Flow API — captures tokens, solves reCAPTCHA, proxies API calls",
  "permissions": [
    "storage",
    "alarms",
    "tabs",
    "webRequest",
    "webNavigation",
    "scripting",
    "declarativeNetRequest",
    "offscreen",
    "sidePanel",
    "activeTab"
  ],
  "host_permissions": [
    "https://flow.google.com/*",
    "http://127.0.0.1:8001/*",
    "http://localhost:8001/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://flow.google.com/*"
      ],
      "js": [
        "keepalive.js",
        "content.js"
      ],
      "all_frames": true,
      "run_at": "document_start"
    },
    {
      "matches": [
        "http://127.0.0.1:*/*",
        "http://localhost:*/*"
      ],
      "js": [
        "keepalive.js",
        "st_injector.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "injected.js",
        "offscreen.html",
        "offscreen.js"
      ],
      "matches": [
        "https://flow.google.com/*",
        "<all_urls>"
      ]
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "referer_rules",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "side_panel": {
    "default_path": "side_panel.html"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Flow"
  }
}
